#!/usr/bin/env bash
set -euo pipefail

# Auto-filled by CMake
PREFIX="@CMAKE_INSTALL_PREFIX@"
BINDIR="@CMAKE_INSTALL_FULL_BINDIR@"
MASTER="${BINDIR}/mc_paipai"
PYTHON="${PAIPAI_PYTHON:-@Python3_EXECUTABLE@}"
FAST_WORKER="${BINDIR}/fast_worker.py"
SLOW_WORKER="${BINDIR}/slow_worker.py"

# Defaults
START_DIR="$(pwd)"
INPUT_STRUC="struc.in"
MODEL="GRACE-2L-OMAT"
DEVICE="cpu"
MODE="finiteT"

NUM_FAST=0
NUM_SLOW=1
NGPU=0

MC_STEPS=200000
MC_TEMP=700
POOL_CAP=128
ROOT_DIR="$(pwd)"
ROOT_EXPLICIT=0
RESUME_STATE=""
CONTINUE=0
FMAX_SCREEN=0.10
MAX_STEPS_SCREEN=30
FMAX_REFINE=0.01
MAX_STEPS_REFINE=400

P_SWAP_METAL=70
P_SWAP_INTER=30
P_HOP_INTER=0
P_CLUSTER_INTER=0
P_EXCH_METAL=0
P_EXCH_INTER=0
INTSITE_NEIGHBOR_CUTOFF=3.5
INTSITE_HOP_CUTOFF=3.0
INTERSTITIAL_SITE_CUTOFF=1.5
PACK_EVERY=0

MC_EXTRA_ARGS=()

usage() {
cat <<EOF
Usage: paipai [options]

Basic options:
  -i, --input FILE              Initial structure file (not required with --resume-state; default: ${INPUT_STRUC})
  --mode MODE                   search | finiteT (default: ${MODE})
  --model NAME                  MLIP model name (default: ${MODEL})
  --device DEV                  cpu | cuda (default: ${DEVICE})
  --ngpu N                      Number of GPUs for round-robin assignment (default: ${NGPU})
  --root DIR                    Root working directory (default: current directory)
  --resume-state DIR            Resume finiteT from a state directory, or from the latest numbered child if DIR is mcprocess
  --continue                    Continue the run in --root from its latest accepted state

Worker options:
  --fast N                      Number of fast workers (default: ${NUM_FAST})
  --slow N                      Number of slow workers (default: ${NUM_SLOW})
  --pool-cap N                  Waiting-pool capacity (default: ${POOL_CAP})
  --fmax-screen X               Fast-worker screen fmax (default: ${FMAX_SCREEN})
  --max-steps-screen N          Fast-worker max screen steps (default: ${MAX_STEPS_SCREEN})
  --fmax-refine X               Slow-worker refine fmax (default: ${FMAX_REFINE})
  --max-steps-refine N          Slow-worker max refine steps (default: ${MAX_STEPS_REFINE})
  --pack-every MIN              Every MIN minutes, pack accepted states into mcprocess_packed/*.tar.gz,
                                keeping 000001 and the newest 5 unpacked (default: ${PACK_EVERY} = off)

Monte Carlo options:
  --steps N                     Run budget: fast-screened structures in search, MC proposals in finiteT (default: ${MC_STEPS})
  --temp T                      Monte Carlo temperature (default: ${MC_TEMP})
  --p-swap-metal N              Weight for metal swap moves (default: ${P_SWAP_METAL})
  --p-swap-inter N              Weight for interstitial swap moves (default: ${P_SWAP_INTER})
  --p-hop-inter N               Weight for local interstitial hop moves (default: ${P_HOP_INTER})
  --p-cluster-inter N           Weight for cluster interstitial swap moves (default: ${P_CLUSTER_INTER})
  --p-exch-metal N              Weight for metal exchange moves (default: ${P_EXCH_METAL})
  --p-exch-inter N              Weight for interstitial exchange moves (default: ${P_EXCH_INTER})
  --intsite-neighbor-cutoff X   Cutoff for interstitial-metal neighbor map (default: ${INTSITE_NEIGHBOR_CUTOFF})
  --intsite-hop-cutoff X        Cutoff for local interstitial hop graph (default: ${INTSITE_HOP_CUTOFF})
  --interstitial-site-cutoff X  Max relaxed interstitial distance to assigned site (default: ${INTERSTITIAL_SITE_CUTOFF})
  --seed N                      Random seed for moves and Metropolis tests (default: drawn from the OS)

Other:
  -h, --help                    Show this help message

Unknown options are passed directly to mc_paipai.
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -i|--input) INPUT_STRUC="$2"; shift 2 ;;
        --mode) MODE="$2"; shift 2 ;;
        --model) MODEL="$2"; shift 2 ;;
        --device) DEVICE="$2"; shift 2 ;;
        --ngpu) NGPU="$2"; shift 2 ;;
        --root) ROOT_DIR="$2"; ROOT_EXPLICIT=1; shift 2 ;;
        --resume-state) RESUME_STATE="$2"; shift 2 ;;
        --continue) CONTINUE=1; MC_EXTRA_ARGS+=("$1"); shift ;;

        --fast) NUM_FAST="$2"; shift 2 ;;
        --slow) NUM_SLOW="$2"; shift 2 ;;
        --pool-cap) POOL_CAP="$2"; shift 2 ;;
        --fmax-screen) FMAX_SCREEN="$2"; shift 2 ;;
        --max-steps-screen) MAX_STEPS_SCREEN="$2"; shift 2 ;;
        --fmax-refine) FMAX_REFINE="$2"; shift 2 ;;
        --max-steps-refine) MAX_STEPS_REFINE="$2"; shift 2 ;;
        --pack-every) PACK_EVERY="$2"; shift 2 ;;

        --steps) MC_STEPS="$2"; shift 2 ;;
        --temp) MC_TEMP="$2"; shift 2 ;;
        --p-swap-metal) P_SWAP_METAL="$2"; shift 2 ;;
        --p-swap-inter) P_SWAP_INTER="$2"; shift 2 ;;
        --p-hop-inter) P_HOP_INTER="$2"; shift 2 ;;
        --p-cluster-inter) P_CLUSTER_INTER="$2"; shift 2 ;;
        --p-exch-metal) P_EXCH_METAL="$2"; shift 2 ;;
        --p-exch-inter) P_EXCH_INTER="$2"; shift 2 ;;
        --intsite-neighbor-cutoff) INTSITE_NEIGHBOR_CUTOFF="$2"; shift 2 ;;
        --intsite-hop-cutoff) INTSITE_HOP_CUTOFF="$2"; shift 2 ;;
        --interstitial-site-cutoff) INTERSTITIAL_SITE_CUTOFF="$2"; shift 2 ;;

        -h|--help) usage; exit 0 ;;
        --) shift; MC_EXTRA_ARGS+=("$@"); break ;;
        *) MC_EXTRA_ARGS+=("$1"); shift ;;
    esac
done

if [[ -n "$RESUME_STATE" && "$MODE" != "finiteT" ]]; then
    echo "[ERROR] --resume-state is only supported with --mode finiteT"
    exit 1
fi

if [[ -n "$RESUME_STATE" && "$ROOT_EXPLICIT" -eq 0 ]]; then
    ROOT_DIR="finiteT_${MC_TEMP}"
fi

abs_path() {
    case "$1" in
        /*|[A-Za-z]:/*|[A-Za-z]:\\*) printf "%s\n" "$1" ;;
        *) printf "%s/%s\n" "$START_DIR" "$1" ;;
    esac
}

ROOT_DIR="$(abs_path "$ROOT_DIR")"
if [[ -n "$RESUME_STATE" && "$INPUT_STRUC" == "struc.in" ]]; then
    INPUT_STRUC=""
else
    INPUT_STRUC="$(abs_path "$INPUT_STRUC")"
fi
if [[ -n "$RESUME_STATE" ]]; then
    RESUME_STATE="$(abs_path "$RESUME_STATE")"
fi

MC_RESUME_ARGS=()
if [[ -n "$RESUME_STATE" ]]; then
    MC_RESUME_ARGS+=(--resume-state "$RESUME_STATE")
fi

MC_INPUT_ARGS=()
if [[ -n "$INPUT_STRUC" ]]; then
    MC_INPUT_ARGS+=("$INPUT_STRUC")
fi

if [[ "$DEVICE" == "cuda" && "$NGPU" -lt 1 ]]; then
    echo "[ERROR] --ngpu must be >= 1 when --device cuda"
    exit 1
fi

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-1}"

mkdir -p "$ROOT_DIR/fast" \
         "$ROOT_DIR/waiting_pool" \
         "$ROOT_DIR/waiting_work" \
         "$ROOT_DIR/refine_outbox" \
         "$ROOT_DIR/reports" \
         "$ROOT_DIR/counters" \
         "$ROOT_DIR/mcprocess"

PIDS=()
WORKER_INDEX=0

# CUDA_VISIBLE_DEVICES set by the scheduler, or by the user to choose GPUs, lists the GPUs this
# run may use. Pick from that list instead of overriding it with 0..NGPU-1.
VISIBLE_GPUS=()
if [[ -n "${CUDA_VISIBLE_DEVICES:-}" ]]; then
    IFS=, read -r -a VISIBLE_GPUS <<< "$CUDA_VISIBLE_DEVICES"
fi

gpu_for_worker() {
    local idx=$(( $1 % NGPU ))
    if (( ${#VISIBLE_GPUS[@]} > 0 )); then
        echo "${VISIBLE_GPUS[$(( idx % ${#VISIBLE_GPUS[@]} ))]}"
    else
        echo "$idx"
    fi
}

# pack_states FLUSH: move accepted states from mcprocess/ into mcprocess_packed/, 200 per tar.gz.
# 000001 (the relaxed starting structure) and the newest 5 states stay unpacked; --continue and
# --resume-state only read the newest. FLUSH=1 also packs a last partial chunk.
# Unpack before analysis: tar -xzf mcprocess_packed/states_A-B.tar.gz -C mcprocess
pack_states() {
    local mc="$ROOT_DIR/mcprocess" out="$ROOT_DIR/mcprocess_packed" names=() d i m n
    for d in "$mc"/[0-9][0-9][0-9][0-9][0-9][0-9]; do
        [[ -d "$d" && "${d##*/}" != 000001 ]] && names+=("${d##*/}")
    done
    n=$(( ${#names[@]} - 5 ))
    mkdir -p "$out"
    for (( i = 0; i < n; i += 200 )); do
        m=$(( n - i < 200 ? n - i : 200 ))
        (( m == 200 || $1 == 1 )) || break
        local chunk=("${names[@]:i:m}")
        tar -czf "$out/.tmp_pack.tar.gz" -C "$mc" "${chunk[@]}" &&
            mv "$out/.tmp_pack.tar.gz" "$out/states_${chunk[0]}-${chunk[m-1]}.tar.gz" &&
            (cd "$mc" && rm -rf "${chunk[@]}")
    done
}

cleanup() {
    echo "[INFO] Cleaning up workers..."
    for pid in "${PIDS[@]:-}" "${MASTER_PID:-}"; do
        kill "$pid" 2>/dev/null || true
    done
}
trap cleanup EXIT INT TERM

echo "[INFO] ROOT_DIR = $ROOT_DIR"
echo "[INFO] INPUT_STRUC = ${INPUT_STRUC:-<resume-state>}"
echo "[INFO] MODE = $MODE"
echo "[INFO] RESUME_STATE = ${RESUME_STATE:-<none>}"
echo "[INFO] NUM_FAST = $NUM_FAST, NUM_SLOW = $NUM_SLOW"
echo "[INFO] MODEL = $MODEL, DEVICE = $DEVICE"
echo "[INFO] NGPU = $NGPU"
echo "[INFO] PYTHON = $PYTHON"
echo "[INFO] MC_STEPS = $MC_STEPS, MC_TEMP = $MC_TEMP"
echo "[INFO] POOL_CAP = $POOL_CAP"
echo "[INFO] Relaxation: fmax_screen=$FMAX_SCREEN, max_steps_screen=$MAX_STEPS_SCREEN, fmax_refine=$FMAX_REFINE, max_steps_refine=$MAX_STEPS_REFINE"
echo "[INFO] Move weights: swap_metal=$P_SWAP_METAL, swap_inter=$P_SWAP_INTER, hop_inter=$P_HOP_INTER, cluster_inter=$P_CLUSTER_INTER, exch_metal=$P_EXCH_METAL, exch_inter=$P_EXCH_INTER"
echo "[INFO] INTSITE_NEIGHBOR_CUTOFF = $INTSITE_NEIGHBOR_CUTOFF"
echo "[INFO] INTSITE_HOP_CUTOFF = $INTSITE_HOP_CUTOFF"
echo "[INFO] INTERSTITIAL_SITE_CUTOFF = $INTERSTITIAL_SITE_CUTOFF"

if [[ "$CONTINUE" -eq 1 ]]; then
    # A job killed during a relaxation leaves the claimed task in waiting_work/, and possibly a
    # result without a report in refine_outbox/. No worker picks these up again, and a finiteT
    # master waits for them forever. Before any worker starts, requeue tasks that never produced
    # a result and drop results that never got a report.
    for d in "$ROOT_DIR"/waiting_work/*/; do
        [[ -d "$d" ]] || continue
        id="$(basename "$d")"
        if [[ -e "$ROOT_DIR/reports/$id.json" || -e "$ROOT_DIR/refine_outbox/$id" ]]; then
            rm -rf "$d"
        else
            mv "$d" "$ROOT_DIR/waiting_pool/$id"
            echo "[INFO] requeued unfinished task $id"
        fi
    done
    for d in "$ROOT_DIR"/refine_outbox/*/; do
        [[ -d "$d" ]] || continue
        id="$(basename "$d")"
        if [[ ! -e "$ROOT_DIR/reports/$id.json" ]]; then
            rm -rf "$d"
            echo "[INFO] dropped result without a report: $id"
        fi
    done
fi

if [[ "$MODE" == "finiteT" ]]; then
    echo "[INFO] finiteT mode: skipping fast workers."
else
    echo "[INFO] Launching $NUM_FAST fast workers..."
    for (( i=1; i<=NUM_FAST; ++i )); do
        LOG_FAST="${ROOT_DIR}/fast_${i}.log"

        if [[ "$DEVICE" == "cuda" ]]; then
            GPU_ID=$(gpu_for_worker "$WORKER_INDEX")
            echo "  -> fast_worker slot $i on GPU $GPU_ID (log: $LOG_FAST)"
            CUDA_VISIBLE_DEVICES="$GPU_ID" "$PYTHON" "$FAST_WORKER" \
                --slot "$i" \
                --root "$ROOT_DIR" \
                --model "$MODEL" \
                --device "$DEVICE" \
                --pool_cap "$POOL_CAP" \
                --fmax_screen "$FMAX_SCREEN" \
                --max_steps_screen "$MAX_STEPS_SCREEN" \
                >"$LOG_FAST" 2>&1 &
        else
            echo "  -> fast_worker slot $i on CPU (log: $LOG_FAST)"
            "$PYTHON" "$FAST_WORKER" \
                --slot "$i" \
                --root "$ROOT_DIR" \
                --model "$MODEL" \
                --device "$DEVICE" \
                --pool_cap "$POOL_CAP" \
                --fmax_screen "$FMAX_SCREEN" \
                --max_steps_screen "$MAX_STEPS_SCREEN" \
                >"$LOG_FAST" 2>&1 &
        fi

        PIDS+=("$!")
        WORKER_INDEX=$((WORKER_INDEX + 1))
    done
fi

echo "[INFO] Launching $NUM_SLOW slow workers..."
for (( j=1; j<=NUM_SLOW; ++j )); do
    ID=$(printf "slow-%02d" "$j")
    LOG_SLOW="${ROOT_DIR}/slow_${ID}.log"

    if [[ "$DEVICE" == "cuda" ]]; then
        GPU_ID=$(gpu_for_worker "$WORKER_INDEX")
        echo "  -> slow_worker $ID on GPU $GPU_ID (log: $LOG_SLOW)"
        CUDA_VISIBLE_DEVICES="$GPU_ID" "$PYTHON" "$SLOW_WORKER" \
            --worker-id "$ID" \
            --root "$ROOT_DIR" \
            --model "$MODEL" \
            --device "$DEVICE" \
            --fmax_refine "$FMAX_REFINE" \
            --max_steps_refine "$MAX_STEPS_REFINE" \
            >"$LOG_SLOW" 2>&1 &
    else
        echo "  -> slow_worker $ID on CPU (log: $LOG_SLOW)"
        "$PYTHON" "$SLOW_WORKER" \
            --worker-id "$ID" \
            --root "$ROOT_DIR" \
            --model "$MODEL" \
            --device "$DEVICE" \
            --fmax_refine "$FMAX_REFINE" \
            --max_steps_refine "$MAX_STEPS_REFINE" \
            >"$LOG_SLOW" 2>&1 &
    fi

    PIDS+=("$!")
    WORKER_INDEX=$((WORKER_INDEX + 1))
done

echo "[INFO] Running C++ master..."
(
    cd "$ROOT_DIR"
    exec "$MASTER" "${MC_INPUT_ARGS[@]}" \
        --mode "$MODE" \
        --workers "$NUM_FAST" \
        --steps "$MC_STEPS" \
        --temp "$MC_TEMP" \
        --p-swap-metal "$P_SWAP_METAL" \
        --p-swap-inter "$P_SWAP_INTER" \
        --p-hop-inter "$P_HOP_INTER" \
        --p-cluster-inter "$P_CLUSTER_INTER" \
        --p-exch-metal "$P_EXCH_METAL" \
        --p-exch-inter "$P_EXCH_INTER" \
        --intsite-neighbor-cutoff "$INTSITE_NEIGHBOR_CUTOFF" \
        --intsite-hop-cutoff "$INTSITE_HOP_CUTOFF" \
        --interstitial-site-cutoff "$INTERSTITIAL_SITE_CUTOFF" \
        "${MC_RESUME_ARGS[@]}" \
        "${MC_EXTRA_ARGS[@]}"
) &
MASTER_PID=$!

# The master waits for worker results indefinitely, so stop as soon as any worker exits.
LAST_PACK=$SECONDS
while kill -0 "$MASTER_PID" 2>/dev/null; do
    for pid in "${PIDS[@]}"; do
        if ! kill -0 "$pid" 2>/dev/null; then
            echo "[ERROR] a worker (pid $pid) exited while the master was running; see the worker logs in $ROOT_DIR"
            exit 1
        fi
    done
    if (( PACK_EVERY > 0 && SECONDS - LAST_PACK >= PACK_EVERY * 60 )); then
        pack_states 0 || true
        LAST_PACK=$SECONDS
    fi
    sleep 5
done
wait "$MASTER_PID"
if (( PACK_EVERY > 0 )); then
    pack_states 1 || true
fi

echo "[INFO] C++ master finished."
